{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSM Railway Track Record",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id":   { "type": "integer" },
    "type": { "type": "string", "enum": ["way", "relation"] },
    "geometry": { "type": "array" },
    "tags": {
      "type": "object",
      "properties": {
        "railway":    { "type": "string" },
        "gauge":      { "type": "string" },
        "electrified":{ "type": "string" },
        "usage":      { "type": "string" },
        "service":    { "type": "string" },
        "maxspeed":   { "type": "string" },
        "bridge":     { "type": "string" },
        "tunnel":     { "type": "string" },
        "layer":      { "type": "string" }
      }
    }
  }
}
