{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSM Railway Platform Record",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id":   { "type": "integer" },
    "type": { "type": "string", "enum": ["node", "way", "relation"] },
    "geometry": { "type": "array" },
    "tags": {
      "type": "object",
      "properties": {
        "railway":    { "type": "string" },
        "ref":        { "type": "string" },
        "name":       { "type": "string" },
        "wheelchair": { "type": "string" }
      }
    }
  }
}
