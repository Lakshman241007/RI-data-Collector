{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSM Railway Bridge Record",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id":   { "type": "integer" },
    "type": { "type": "string", "enum": ["way", "relation"] },
    "geometry": { "type": "array" },
    "tags": {
      "type": "object",
      "properties": {
        "bridge":  { "type": "string" },
        "railway": { "type": "string" },
        "name":    { "type": "string" }
      }
    }
  }
}
