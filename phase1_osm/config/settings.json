{
  "overpass": {
    "endpoint": "https://overpass.private.coffee/api/interpreter",
    "timeout": 300,
    "retries": 3,
    "retry_backoff": 5,
    "region": "Tamil Nadu",
    "user_agent": "TamilNaduRailwayCollector/1.0"
  },
  "geofabrik": {
    "url": "https://download.geofabrik.de/asia/india-latest.osm.pbf",
    "download_dir": "input",
    "filename": "india-latest.osm.pbf",
    "chunk_size": 8192,
    "download_retries": 3
  },
  "output": {
    "output_dir": "output",
    "raw_overpass_file": "raw_overpass.json",
    "raw_geofabrik_file": "raw_geofabrik.json",
    "master_dataset_file": "master_railway_dataset.json",
    "validation_file": "validation.json",
    "statistics_file": "statistics.json"
  },
  "logging": {
    "log_dir": "logs",
    "level": "INFO"
  },
  "validation": {
    "remove_duplicates": true,
    "prefer_overpass": true,
    "validate_geometry": true
  },
  "cache": {
    "enabled": true,
    "directory": "cache"
  }
}