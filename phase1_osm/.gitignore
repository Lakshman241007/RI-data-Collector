# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Downloaded GeoFabrik extract (large binary, regenerated on demand)
input/*.pbf
input/*.osm.pbf

# Generated pipeline outputs and logs (regenerated by running main.py)
output/*.json
logs/*.log

# Keep folder structure even though contents are ignored
!input/.gitkeep
!output/.gitkeep
!logs/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store

# Pytest cache
.pytest_cache/
